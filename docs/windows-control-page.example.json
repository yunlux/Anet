{
  "version": 1,
  "sequence": 1,
  "network": "community",
  "repo_url": "https://github.com/yunlux/Anet",
  "repo_ref": "main",
  "poll_seconds": 300,
  "software": {
    "version": "0.13.0"
  },
  "config": {
    "sync_interval": 2.0,
    "sync_jitter": 0.2,
    "listen_enabled": true,
    "direct_enabled": true
  },
  "platforms": {
    "windows": {
      "config": {
        "listen_host": "0.0.0.0",
        "listen_port": 43111,
        "locator_contexts": ["host:REPLACE_WITH_SHARED_HOST_ZONE"],
        "advertise": [
          "tls://REPLACE_WITH_SHARED_HOST_ADDRESS:43111?scope=host&zone=REPLACE_WITH_SHARED_HOST_ZONE&priority=0"
        ]
      }
    },
    "wsl": {
      "config": {
        "listen_host": "0.0.0.0",
        "listen_port": 43112,
        "locator_contexts": ["host:REPLACE_WITH_SHARED_HOST_ZONE"],
        "advertise": [
          "tls://REPLACE_WITH_SHARED_HOST_ADDRESS:43112?scope=host&zone=REPLACE_WITH_SHARED_HOST_ZONE&priority=0"
        ]
      }
    }
  },
  "nodes": [
    {
      "card_url": "https://example.invalid/network/node-a.card.json"
    }
  ],
  "control_publishers": {
    "actor-a": "BASE64URL_ED25519_PUBLIC_KEY"
  },
  "pages": [
    {
      "url": "https://example.invalid/network/community-page.json",
      "key_id": "actor-a"
    }
  ]
}
