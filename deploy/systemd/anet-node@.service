[Unit]
Description=Anet encrypted node (%i)
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/anet/current/venv/bin/anet --home %h/.local/state/anet/nodes/%i serve
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/anet/%i.env

[Install]
WantedBy=default.target
